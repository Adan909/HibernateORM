<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.hibernateorm.controller.EstudianteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Registro de Estudiantes (Hibernate ORM)"/>

    <!-- Formulario de Entrada -->
    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombres" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtApellidos" prefWidth="250.0" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtCorreo" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTelefono" prefWidth="250.0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Carrera:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbCarrera" prefWidth="250.0" promptText="Seleccione Carrera" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <!-- Acciones -->
    <HBox spacing="10.0">
        <Button fx:id="btnGuardar" onAction="#handleGuardar" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="Guardar"/>
        <Button fx:id="btnConsultar" onAction="#handleConsultar" text="Consultar Todos"/>
        <Button onAction="#handleFiltrarPorCarrera" text="Filtrar por Carrera"/>
    </HBox>

    <!-- Tabla de Resultados -->
    <TableView fx:id="tablaEstudiantes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
            <TableColumn fx:id="colNombres" prefWidth="160.0" text="Nombres"/>
            <TableColumn fx:id="colApellidos" prefWidth="160.0" text="Apellidos"/>
            <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo"/>
            <TableColumn fx:id="colCarrera" prefWidth="180.0" text="Carrera"/>
            <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono"/>
        </columns>
    </TableView>
</VBox>